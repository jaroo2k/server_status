# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes stored SSH credentials unreadable.
FERNET_KEY=
COLLECT_TICK_SECONDS=15
MAX_CONCURRENCY=50
# Telegram alerts: stay off unless both the token and the chat id are set.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# critical (default) | warning | info
TELEGRAM_MIN_SEVERITY=critical
